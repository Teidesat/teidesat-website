<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- LAYOUT BASE -->
    <template id="teidesat_base_layout" name="Teidesat Base Layout">
        <html lang="es">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>

                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
                <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>

                <title>TEIDESAT</title>

                <t t-call-assets="web.assets_frontend"/>
            </head>

            <body class="teidesat-page">

                <!-- HEADER -->
            <header class="teidesat-custom-header">
                <div class="teidesat-custom-header__inner">

                    <a href="/" class="teidesat-custom-header__logo">
                        <img src="/teidesat_website/static/src/img/Logo TEIDESAT - Blanco sobre transparente.png"
                            alt="TEIDESAT"
                            class="teidesat-logo"/>
                    </a>

                    <nav class="teidesat-desktop-nav">
                        <a href="/nosotros">Sobre nosotros</a>
                        <a href="/divulgacion">Divulgación</a>
                        <a href="/participa">Participa</a>
                        <a href="/departamentos">Departamentos</a>
                        <a href="/teidesatkids">TeidesatKids</a>
                        <a href="/contacto">Contacto</a>
                    </nav>

                        <button class="teidesat-menu-toggle"
                                type="button"
                                id="teidesat-menu-toggle"
                                aria-label="Abrir menú de navegación"
                                aria-expanded="false"
                                aria-controls="teidesat-side-menu">
                            <span aria-hidden="true"></span>
                            <span aria-hidden="true"></span>
                            <span aria-hidden="true"></span>
                        </button>

                </div>
            </header>

                <div class="teidesat-menu-overlay" id="teidesat-menu-overlay" aria-hidden="true"></div>

                <aside class="teidesat-side-menu" id="teidesat-side-menu" aria-hidden="true" aria-label="Menú de navegación principal">
                    <div class="teidesat-side-menu__top">
                        <button class="teidesat-side-menu__close"
                                type="button"
                                id="teidesat-menu-close"
                                aria-label="Cerrar menú de navegación">
                            ×
                        </button>
                    </div>

                    <nav class="teidesat-side-menu__nav" aria-label="Navegación principal">
                        <a href="/">Inicio</a>
                        <a href="/nosotros">Sobre nosotros</a>
                        <a href="/divulgacion">Divulgación</a>
                        <a href="/participa">Participa</a>
                        <a href="/departamentos">Departamentos</a>
                        <a href="/teidesatkids">TeidesatKids</a>
                        <a href="/contacto">Contacto</a>
                    </nav>
                </aside>

                <!-- CONTENIDO INYECTADO -->
                <main class="teidesat-main">
                    <t t-out="0"/>
                </main>

                <!-- FOOTER -->
                <footer class="teidesat-footer-sponsors" id="patrocinadores" aria-label="Patrocinadores y colaboradores">
                    <div class="container">

                        <div class="teidesat-footer-sponsors__heading">
                            <span class="section-kicker--right" tabindex="0">PATROCINADORES / COLABORADORES</span>
                        </div>

                        <div class="teidesat-footer-sponsors__grid">

                            <a href="#" class="teidesat-footer-sponsor" aria-label="Cátedra Fundación Cepsa">
                                <img src="/teidesat_website/static/src/img/partners/catedra-cepsa.png" alt="Cátedra Fundación Cepsa"/>
                            </a>

                            <a href="#" class="teidesat-footer-sponsor" aria-label="Universidad de Las Palmas de Gran Canaria">
                                <img src="/teidesat_website/static/src/img/partners/ulpgc.png" alt="Universidad de Las Palmas de Gran Canaria"/>
                            </a>

                            <a href="#" class="teidesat-footer-sponsor" aria-label="Hyperspace Canarias">
                                <img src="/teidesat_website/static/src/img/partners/hyperspace.png" alt="Hyperspace Canarias"/>
                            </a>

                            <a href="#" class="teidesat-footer-sponsor" aria-label="Cepsa">
                                <img src="/teidesat_website/static/src/img/partners/cepsa.png" alt="Cepsa"/>
                            </a>

                            <a href="#" class="teidesat-footer-sponsor" aria-label="Universidad de La Laguna">
                                <img src="/teidesat_website/static/src/img/partners/ull.png" alt="Universidad de La Laguna"/>
                            </a>

                            <a href="#" class="teidesat-footer-sponsor" aria-label="URE">
                                <img src="/teidesat_website/static/src/img/partners/ure.png" alt="URE"/>
                            </a>

                            <a href="#" class="teidesat-footer-sponsor" aria-label="Big Signal">
                                <img src="/teidesat_website/static/src/img/partners/big-signal.png" alt="Big Signal"/>
                            </a>

                            <a href="#" class="teidesat-footer-sponsor" aria-label="OrCAD">
                                <img src="/teidesat_website/static/src/img/partners/orcad.png" alt="OrCAD"/>
                            </a>

                            <a href="#" class="teidesat-footer-sponsor" aria-label="Cadence">
                                <img src="/teidesat_website/static/src/img/partners/cadence.png" alt="Cadence"/>
                            </a>

                            <a href="#" class="teidesat-footer-sponsor" aria-label="Altium">
                                <img src="/teidesat_website/static/src/img/partners/altium.png" alt="Altium"/>
                            </a>
                        </div>
                    </div>
                </footer>

            </body>
        </html>
    </template>


    <!-- HOME -->
    <template id="teidesat_homepage" name="Teidesat Homepage">
        <t t-call="teidesat_website.teidesat_base_layout">
        <div class="teidesat-page-home">

            <!-- HERO -->
            <section class="teidesat-hero teidesat-hero--day" id="hero" aria-labelledby="hero-title">
                <div class="teidesat-hero-overlay" aria-hidden="true"></div>
                <div class="container position-relative">
                    <div class="teidesat-hero-content">
                        <div class="hero-title-block reveal-up">
                            <span class="section-kicker--right" aria-hidden="true">TEIDESAT</span>
                            <h1 class="teidesat-hero-main-title" id="hero-title" tabindex="0">
                                El primer nanosatélite universitario de Canarias
                            </h1>
                        </div>
                        <div class="hero-satellite hero-satellite--drift" aria-hidden="true">
                            <img src="/teidesat_website/static/src/img/cubesat.png" alt="" class="hero-satellite-img"/>
                        </div>
                    </div>
                </div>
            </section>

            <!-- OBJETIVOS -->
            <section id="objetivos" class="teidesat-section teidesat-section-dark" aria-labelledby="objetivos-title">
                <div class="container">
                    <div class="teidesat-objectives-stage reveal-up">

                        <div class="teidesat-objectives-heading section-heading">
                            <span class="section-kicker--right" aria-hidden="true">Exosfera</span>
                            <h2 id="objetivos-title" tabindex="0">Nuestros objetivos</h2>
                            <p tabindex="0">
                                Haz clic en cada punto para descubrir los principales objetivos de TEIDESAT.
                            </p>
                        </div>

                        <div class="teidesat-objectives-system" role="group" aria-label="Sistema interactivo de objetivos">

                            <svg class="objectives-orbits-svg" viewBox="0 0 760 760" aria-hidden="true" focusable="false">
                                <ellipse id="orbit-path-1" cx="380" cy="380" rx="110" ry="64" />
                                <ellipse id="orbit-path-2" cx="380" cy="380" rx="175" ry="104" />
                                <ellipse id="orbit-path-3" cx="380" cy="380" rx="240" ry="144" />
                                <ellipse id="orbit-path-4" cx="380" cy="380" rx="305" ry="184" />
                                <ellipse id="orbit-path-5" cx="380" cy="380" rx="370" ry="224" />
                            </svg>

                            <button class="objectives-core" type="button" id="objectives-toggle-all"
                                    aria-label="Mostrar u ocultar todos los objetivos"
                                    aria-expanded="false">
                                <span aria-hidden="true">OBJETIVOS</span>
                            </button>

                            <button class="objective-node" data-target="objetivo-2" data-orbit="1" type="button"
                                    aria-label="Objetivo 1: Misión" aria-pressed="false">
                                <span class="objective-node__label" aria-hidden="true">1</span>
                            </button>

                            <button class="objective-node" data-target="objetivo-1" data-orbit="2" type="button"
                                    aria-label="Objetivo 2: Tecnológico" aria-pressed="false">
                                <span class="objective-node__label" aria-hidden="true">2</span>
                            </button>

                            <button class="objective-node" data-target="objetivo-3" data-orbit="3" type="button"
                                    aria-label="Objetivo 3: Científico" aria-pressed="false">
                                <span class="objective-node__label" aria-hidden="true">3</span>
                            </button>

                            <button class="objective-node" data-target="objetivo-4" data-orbit="4" type="button"
                                    aria-label="Objetivo 4: Académico" aria-pressed="false">
                                <span class="objective-node__label" aria-hidden="true">4</span>
                            </button>

                            <button class="objective-node" data-target="objetivo-5" data-orbit="5" type="button"
                                    aria-label="Objetivo 5: Divulgativo" aria-pressed="false">
                                <span class="objective-node__label" aria-hidden="true">5</span>
                            </button>
                        </div>

                        <!-- Los paneles reciben tabindex="0" para que Tab los alcance cuando están visibles.
                             El JS existente que los muestra/oculta no se toca. -->
                        <div class="objective-panel objective-panel--1" data-panel="objetivo-1"
                             role="region" aria-labelledby="obj-title-1" tabindex="0">
                            <h3 id="obj-title-1">Objetivo Tecnológico</h3>
                            <p>
                                Diseñar y construir un nanosatélite para comunicaciones ópticas
                                conforme a requisitos del sector espacial.
                            </p>
                        </div>

                        <div class="objective-panel objective-panel--2" data-panel="objetivo-2"
                             role="region" aria-labelledby="obj-title-2" tabindex="0">
                            <h3 id="obj-title-2">Misión</h3>
                            <p>
                                Diseñar, fabricar, poner en órbita y operar el primer nanosatélite
                                universitario de Canarias.
                            </p>
                        </div>

                        <div class="objective-panel objective-panel--3" data-panel="objetivo-3"
                             role="region" aria-labelledby="obj-title-3" tabindex="0">
                            <h3 id="obj-title-3">Objetivo Científico</h3>
                            <p>
                                Analizar el impacto de la contaminación lumínica espacial mediante
                                observación y transmisión de datos.
                            </p>
                        </div>

                        <div class="objective-panel objective-panel--4" data-panel="objetivo-4"
                             role="region" aria-labelledby="obj-title-4" tabindex="0">
                            <h3 id="obj-title-4">Objetivo Académico</h3>
                            <p>
                                Formar al alumnado en un entorno real de ingeniería espacial,
                                promoviendo aprendizaje interdisciplinar.
                            </p>
                        </div>

                        <div class="objective-panel objective-panel--5" data-panel="objetivo-5"
                             role="region" aria-labelledby="obj-title-5" tabindex="0">
                            <h3 id="obj-title-5">Objetivo Divulgativo</h3>
                            <p>
                                Inspirar a nuevas generaciones a través de talleres, eventos y
                                actividades de divulgación científica y tecnológica.
                            </p>
                        </div>

                    </div>
                </div>
            </section>

            <!-- QUIERES SABER MAS -->
            <section id="mas-info" class="teidesat-section teidesat-section-gradient" aria-labelledby="mas-info-title">
                <div class="container">
                    <div class="section-heading reveal-up">
                        <span class="section-kicker--right" aria-hidden="true">Termosfera</span>
                        <h2 id="mas-info-title" tabindex="0">¿Quieres saber más?</h2>
                        <p tabindex="0">
                            Explora más sobre TEIDESAT, consulta preguntas frecuentes y descubre
                            novedades relacionadas con la misión.
                        </p>
                    </div>

                    <nav class="teidesat-more-links reveal-up" aria-label="Redes sociales de TEIDESAT">
                        <a href="https://www.instagram.com/teidesat/" target="_blank" rel="noopener noreferrer"
                           class="teidesat-more-link"
                           aria-label="Seguir TEIDESAT en Instagram (abre en nueva pestaña)">
                            <span class="teidesat-more-link__icon" aria-hidden="true"><i class="fa fa-instagram"></i></span>
                            <span class="teidesat-more-link__label">Instagram</span>
                        </a>
                        <a href="https://www.facebook.com/profile.php?id=100063464266134" target="_blank" rel="noopener noreferrer"
                           class="teidesat-more-link"
                           aria-label="Seguir TEIDESAT en Facebook (abre en nueva pestaña)">
                            <span class="teidesat-more-link__icon" aria-hidden="true"><i class="fa fa-facebook"></i></span>
                            <span class="teidesat-more-link__label">Facebook</span>
                        </a>
                        <a href="https://www.youtube.com/@TEIDESAT" target="_blank" rel="noopener noreferrer"
                           class="teidesat-more-link"
                           aria-label="Ver TEIDESAT en YouTube (abre en nueva pestaña)">
                            <span class="teidesat-more-link__icon" aria-hidden="true"><i class="fa fa-youtube-play"></i></span>
                            <span class="teidesat-more-link__label">YouTube</span>
                        </a>
                        <a href="https://x.com/teidesat" target="_blank" rel="noopener noreferrer"
                           class="teidesat-more-link"
                           aria-label="Seguir TEIDESAT en X, anteriormente Twitter (abre en nueva pestaña)">
                            <span class="teidesat-more-link__icon" aria-hidden="true"><span aria-hidden="true">X</span></span>
                            <span class="teidesat-more-link__label">X (Twitter)</span>
                        </a>
                    </nav>

                    <!-- FAQ -->
                    <div class="teidesat-faq reveal-up">
                        <div class="teidesat-faq__heading">
                            <h3 tabindex="0">Preguntas frecuentes</h3>
                        </div>

                        <div class="teidesat-faq__list">
                            <div class="teidesat-faq-item teidesat-faq-item--left">
                                <button class="teidesat-faq-item__question" type="button"
                                        aria-expanded="false" aria-controls="faq-answer-1">
                                    <span>¿Qué es TEIDESAT?</span>
                                    <span class="teidesat-faq-item__icon" aria-hidden="true">+</span>
                                </button>
                                <!-- tabindex="0" para que Tab alcance la respuesta una vez abierta -->
                                <div class="teidesat-faq-item__answer" id="faq-answer-1" tabindex="-1" hidden="hidden">
                                    <p>
                                        TEIDESAT es el primer nanosatélite universitario de Canarias,
                                        concebido como una misión tecnológica, científica y educativa.
                                    </p>
                                </div>
                            </div>

                            <div class="teidesat-faq-item teidesat-faq-item--right">
                                <button class="teidesat-faq-item__question" type="button"
                                        aria-expanded="false" aria-controls="faq-answer-2">
                                    <span>¿Cuál es el objetivo principal de la misión?</span>
                                    <span class="teidesat-faq-item__icon" aria-hidden="true">+</span>
                                </button>
                                <div class="teidesat-faq-item__answer" id="faq-answer-2" tabindex="-1" hidden="hidden">
                                    <p>
                                        Diseñar, fabricar, lanzar y operar un nanosatélite universitario,
                                        desarrollando además capacidades de investigación y formación.
                                    </p>
                                </div>
                            </div>

                            <div class="teidesat-faq-item teidesat-faq-item--left">
                                <button class="teidesat-faq-item__question" type="button"
                                        aria-expanded="false" aria-controls="faq-answer-3">
                                    <span>¿Quién participa en el proyecto?</span>
                                    <span class="teidesat-faq-item__icon" aria-hidden="true">+</span>
                                </button>
                                <div class="teidesat-faq-item__answer" id="faq-answer-3" tabindex="-1" hidden="hidden">
                                    <p>
                                        Participan estudiantes, profesorado, personal investigador y distintas
                                        entidades colaboradoras del ámbito académico, tecnológico y espacial.
                                    </p>
                                </div>
                            </div>

                            <div class="teidesat-faq-item teidesat-faq-item--right">
                                <button class="teidesat-faq-item__question" type="button"
                                        aria-expanded="false" aria-controls="faq-answer-4">
                                    <span>¿Cómo se pueden seguir sus avances?</span>
                                    <span class="teidesat-faq-item__icon" aria-hidden="true">+</span>
                                </button>
                                <div class="teidesat-faq-item__answer" id="faq-answer-4" tabindex="-1" hidden="hidden">
                                    <p>
                                        A través de sus redes sociales, publicaciones, eventos de divulgación
                                        y futuras actualizaciones dentro de la propia web.
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- NOVEDADES -->
                    <div class="teidesat-news reveal-up">
                        <div class="teidesat-news__heading">
                            <h3 tabindex="0">Novedades</h3>
                        </div>

                        <div class="teidesat-news-slider" data-slider="news"
                             role="region" aria-label="Carrusel de novedades de TEIDESAT">
                            <div class="teidesat-news-slider__viewport">
                                <div class="teidesat-news-slider__track">

                                    <article class="teidesat-news-card" tabindex="0">
                                        <span class="teidesat-news-card__tag">Evento</span>
                                        <p class="teidesat-news-card__title">Talleres y charlas</p>
                                        <p>Actividades de divulgación y encuentros para acercar el proyecto al alumnado y al público general.</p>
                                    </article>

                                    <article class="teidesat-news-card" tabindex="0">
                                        <span class="teidesat-news-card__tag">Proyecto</span>
                                        <p class="teidesat-news-card__title">Avances de desarrollo</p>
                                        <p>Seguimiento del estado actual de integración, pruebas y evolución de la misión.</p>
                                    </article>

                                    <article class="teidesat-news-card" tabindex="0">
                                        <span class="teidesat-news-card__tag">Comunidad</span>
                                        <p class="teidesat-news-card__title">Participación y difusión</p>
                                        <p>Noticias sobre colaboraciones, actividades y nuevas iniciativas relacionadas con TEIDESAT.</p>
                                    </article>

                                    <article class="teidesat-news-card" tabindex="0">
                                        <span class="teidesat-news-card__tag">Misión</span>
                                        <p class="teidesat-news-card__title">Próximos hitos</p>
                                        <p>Resumen de próximas fases relevantes dentro del recorrido técnico y académico del proyecto.</p>
                                    </article>

                                    <article class="teidesat-news-card" tabindex="0">
                                        <span class="teidesat-news-card__tag">Actualidad</span>
                                        <p class="teidesat-news-card__title">Nuevas publicaciones</p>
                                        <p>Difusión de noticias, artículos y materiales relacionados con la evolución del proyecto.</p>
                                    </article>

                                    <article class="teidesat-news-card" tabindex="0">
                                        <span class="teidesat-news-card__tag">Equipo</span>
                                        <p class="teidesat-news-card__title">Vida del proyecto</p>
                                        <p>Pequeñas actualizaciones sobre el trabajo del equipo y el día a día de la misión.</p>
                                    </article>

                                </div>
                            </div>
                            <div class="teidesat-news-slider__dots" role="group" aria-label="Controles del carrusel"></div>
                        </div>
                    </div>
                </div>
            </section>

            <!-- TIMELINE -->
            <section id="fases" class="teidesat-section teidesat-section-gradient" aria-labelledby="fases-title">
                <div class="container">
                    <div class="section-heading reveal-up">
                        <span class="section-kicker--right" aria-hidden="true">Mesosfera</span>
                        <h2 id="fases-title" tabindex="0">Fases del proyecto</h2>
                        <p tabindex="0">
                            Desde la concepción inicial hasta la futura fase operativa, TEIDESAT ha
                            evolucionado a lo largo de varias etapas técnicas, organizativas y académicas.
                        </p>
                    </div>

                    <div class="teidesat-timeline" role="list" aria-label="Fases del proyecto TEIDESAT">

                        <div class="timeline-item reveal-up" role="listitem">
                            <div class="timeline-dot" aria-hidden="true"></div>
                            <div class="timeline-card" tabindex="0">
                                <span class="timeline-period">2017 – 2022</span>
                                <h3>Fase 0 a B2</h3>
                                <p>Diseño preliminar, definición del concepto de misión y adaptación del proyecto tras los retrasos derivados de la pandemia.</p>
                            </div>
                        </div>

                        <div class="timeline-item reveal-up" role="listitem">
                            <div class="timeline-dot" aria-hidden="true"></div>
                            <div class="timeline-card" tabindex="0">
                                <span class="timeline-period">2023 – 2024</span>
                                <h3>Fase C</h3>
                                <p>Consolidación del diseño y planificación del modelo de vuelo, estableciendo una base técnica más madura para la misión.</p>
                            </div>
                        </div>

                        <div class="timeline-item reveal-up" role="listitem">
                            <div class="timeline-dot" aria-hidden="true"></div>
                            <div class="timeline-card" tabindex="0">
                                <span class="timeline-period">2024 – 2025</span>
                                <h3>Fase D1</h3>
                                <p>Fabricación de los distintos subsistemas del satélite y desarrollo de componentes clave para su integración.</p>
                            </div>
                        </div>

                        <div class="timeline-item reveal-up" role="listitem">
                            <div class="timeline-dot" aria-hidden="true"></div>
                            <div class="timeline-card" tabindex="0">
                                <span class="timeline-period">2025</span>
                                <h3>Fase D2</h3>
                                <p>Pruebas y verificación funcional para validar el comportamiento del sistema antes del lanzamiento.</p>
                            </div>
                        </div>

                        <div class="timeline-item reveal-up" role="listitem">
                            <div class="timeline-dot" aria-hidden="true"></div>
                            <div class="timeline-card" tabindex="0">
                                <span class="timeline-period">2025 – 2027</span>
                                <h3>Lanzamiento</h3>
                                <p>Preparación para el lanzamiento en colaboración con la empresa española PLD SPACE.</p>
                            </div>
                        </div>

                        <div class="timeline-item reveal-up" role="listitem">
                            <div class="timeline-dot" aria-hidden="true"></div>
                            <div class="timeline-card" tabindex="0">
                                <span class="timeline-period">Fase operativa</span>
                                <h3>Misión en órbita</h3>
                                <p>Ejecución de experimentos, transmisión de datos y actividades educativas durante aproximadamente 1 a 1,5 años.</p>
                            </div>
                        </div>

                    </div>
                </div>
            </section>

            <!-- DESARROLLO Y ESTADO -->
            <section id="desarrollo" class="teidesat-section teidesat-section-dark" aria-labelledby="desarrollo-title">
                <div class="container">
                    <div class="section-heading reveal-up">
                        <span class="section-kicker--right" aria-hidden="true">Estratosfera</span>
                        <h2 id="desarrollo-title" tabindex="0">Desarrollo y estado actual de la misión</h2>
                        <p tabindex="0">
                            TEIDESAT-1 evolucionó de un CubeSat 1U a una arquitectura 2U para
                            incorporar nuevas capacidades de orientación, potencia y operación.
                        </p>
                    </div>

                    <div class="feature-highlight reveal-up">
                        <div class="feature-highlight__text" tabindex="0">
                            <h3>De 1U a 2U</h3>
                            <p>
